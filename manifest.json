{
  "manifest_version": 3,
  "name": "BetterMessages",
  "version": "1.0.0",
  "description": "A compact, supercharged Google Messages sidebar for Chrome & Chromium browsers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "browsingData",
    "offscreen",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://messages.google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BetterMessages",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle BetterMessages sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://messages.google.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://messages.google.com/*"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_framing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
